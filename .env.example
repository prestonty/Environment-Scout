# Shared secret the device sends as the X-API-Key header on POST /api/readings.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-with-a-long-random-string

# Optional separate key for GET /api/readings (read-back / dashboard use).
# If unset, READ_API_KEY defaults to API_KEY.
READ_API_KEY=

# Supabase Postgres connection string (Project Settings -> Database ->
# Connection string -> "URI", DIRECT connection, not the pgbouncer pooler --
# asyncpg's prepared statements don't play well with pgbouncer transaction
# pooling, and traffic here is tiny (one device, once a day) so a direct
# connection with a small pool is simplest and correct).
# Example: postgresql://postgres:[password]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
