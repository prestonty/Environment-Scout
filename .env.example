# Shared secret the device sends as the X-API-Key header on POST /api/readings.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-with-a-long-random-string

# Optional separate key for GET /api/readings (read-back / dashboard use).
# If unset, READ_API_KEY defaults to API_KEY.
READ_API_KEY=

# Supabase Postgres connection string. Use the "Session pooler" string, not
# "Direct connection" (Supabase gates that behind IPv6/a paid IPv4 add-on,
# and Render's outbound networking is IPv4-only anyway) and not "Transaction
# pooler" (that one recycles backend connections mid-session, which breaks
# asyncpg's prepared statements). Get it from the project's Connect dialog ->
# Session pooler tab.
# Example: postgresql://postgres.xxxxxxxxxxxx:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
